{
    "name": "resu-server",
    "version": "1.0.0",
    "description": "",
    "main": "dist/server.js",
    "dependencies": {
        "bytebuffer": "^5.0.1",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.4.1",
        "eslint": "^10.9.1",
        "globals": "^17.12.0",
        "prettier": "^3.9.6",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.69.0"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsc && node scripts/copy-assets.cjs",
        "dev": "NODE_ENV=development tsx watch src/server.ts",
        "compact-objs": "tsx src/scripts/compactObjsJson.ts",
        "compact-npcs": "tsx src/scripts/compactNpcsJson.ts",
        "export-editable-maps": "tsx src/scripts/exportEditableMaps.ts",
        "export-frontend-graphics": "tsx src/scripts/exportFrontendOptimizedGraphics.ts",
