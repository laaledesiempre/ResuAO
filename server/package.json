        "export-client-objs": "tsx src/scripts/exportClientObjs.ts",
        "start": "node dist/server.js",
        "lint": "eslint './src/**/*.ts'",
        "world-map": "node scripts/build-world-map.cjs",
        "compare-original-data": "tsx src/scripts/compareOriginalData.ts"
    },
    "repository": {
