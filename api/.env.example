PORT=3001
TOKEN_AUTH=changeme
CORS_ORIGIN=http://localhost:3000

# Database backend: "postgres" (default) or "sqlite".
# DB_BACKEND=postgres
DB_BACKEND=postgres

# Required when DB_BACKEND=postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resu

# SQLite database file path (only when DB_BACKEND=sqlite).
# Defaults to ./resu.sqlite relative to the api/ package.
# The schema (schema.sqlite.sql) is applied automatically at startup.
# SQLITE_PATH=./resu.sqlite

# Directory where admin-uploaded branding assets are stored and served from
# (POST /api/admin/upload, GET /api/uploads/*).
# Defaults to ./uploads relative to the api/ package.
# UPLOADS_DIR=./uploads

# Unified entrypoint (npm run unified / src/unified.ts):
# runs the API and the game WebSocket server in one process.
# GAME_PORT sets the game server port (default 7666); API_BASE_URL is the
# loopback URL the game server uses to reach this API (the unified entry
# defaults it to http://127.0.0.1:<api port>). CLI flags --port/--game-port/--db
# override the corresponding env vars.
# GAME_PORT=7666
# API_BASE_URL=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# Mail provider (PLANNED, NOT YET IMPLEMENTED)
# Reserved for a future transactional-mail integration (password reset,
# account notifications). These variables are parsed nowhere yet; setting
# them has no effect.
#   MAIL_PROVIDER  - provider identifier (e.g. "resend", "sendgrid", "smtp")
#   MAIL_API_KEY   - API key / credentials for the chosen provider
#   MAIL_FROM      - sender address, e.g. "Resu <no-reply@example.com>"
# ---------------------------------------------------------------------------
# MAIL_PROVIDER=
# MAIL_API_KEY=
# MAIL_FROM=
